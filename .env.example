# --- local development ---
DATABASE_URL="postgresql://user@localhost:5432/bdmf_dev"
APP_URL="http://localhost:3000"

# NOTE: there is deliberately no session-signing secret. Sessions are opaque
# 32-byte random tokens stored hashed (SHA-256) in the sessions table, so there
# is nothing to sign and no secret that could forge one if leaked.

# --- email (Resend). Leave blank to log emails to the console instead. ---
RESEND_API_KEY=""
MAIL_FROM="BDMF <onboarding@resend.dev>"

# --- AI summaries (Anthropic). Leave blank to use the deterministic fallback. ---
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-opus-5"
